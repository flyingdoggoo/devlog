# Core
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database / Cache
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/devlog?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxxxx.region.aws.neon.tech/devlog?sslmode=require
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=replace-me-with-strong-secret
JWT_ACCESS_TOKEN_EXPIRATION_TIME=900
JWT_REFRESH_TOKEN_EXPIRATION_TIME=604800

# Google OAuth (required by current GoogleStrategy getOrThrow)
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Cloudinary (for post cover uploads)
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

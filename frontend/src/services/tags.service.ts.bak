import apiClient from '@services/api';
import type { Tag, CreateTagDto, UpdateTagDto } from '@types/tag';
import type { ApiResponse } from '@types/api';

export const tagsApi = {
  // Get all tags
  getAllTags: async (): Promise<ApiResponse<Tag[]>> => {
    const response = await apiClient.get('/tags');
    return response.data;
  },

  // Get tag by ID
  getTagById: async (id: string): Promise<ApiResponse<Tag>> => {
    const response = await apiClient.get(`/tags/${id}`);
    return response.data;
  },

  // Create new tag
  createTag: async (data: CreateTagDto): Promise<ApiResponse<Tag>> => {
    const response = await apiClient.post('/tags', data);
    return response.data;
  },

  // Update tag
  updateTag: async (id: string, data: UpdateTagDto): Promise<ApiResponse<Tag>> => {
    const response = await apiClient.patch(`/tags/${id}`, data);
    return response.data;
  },

  // Delete tag
  deleteTag: async (id: string): Promise<ApiResponse<void>> => {
    const response = await apiClient.delete(`/tags/${id}`);
    return response.data;
  },
};
